<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org" name="diff_bot">

  <xacro:arg name="use_mock_hardware" default="false"/>
  <xacro:arg name="use_gazebo" default="false"/>

  <!-- ==================== XACRO PROPERTIES ==================== -->
  <xacro:property name="base_z_offset" value="0.1"/>

  <!-- Chassis Dimensions & Positioning -->
  <xacro:property name="chassis_x" value="0.248"/>
  <xacro:property name="chassis_y" value="0.140"/>
  <xacro:property name="chassis_z" value="0.038"/>
  <xacro:property name="chassis_x_offset" value="-0.055"/>
  <xacro:property name="chassis_y_offset" value="0.0"/>
  <xacro:property name="chassis_z_offset" value="0.0"/>

  <!-- Wheel Dimensions & Positioning -->
  <xacro:property name="wheel_link_x_offset" value="-0.054"/>
  <xacro:property name="wheel_link_y_offset" value="${chassis_y / 2 + 0.002}"/>
  <xacro:property name="wheel_link_z_offset" value="-0.003"/>
  <xacro:property name="wheel_length" value="0.025"/>
  <xacro:property name="wheel_radius" value="0.032"/>
  <xacro:property name="wheel_x_offset" value="0"/>
  <xacro:property name="wheel_y_offset" value="${wheel_length / 2}"/>
  <xacro:property name="wheel_z_offset" value="0"/>

   <!-- Caster Wheel Properties -->
  <xacro:property name="caster_radius"   value="0.017"/>
  <xacro:property name="caster_x_offset" value="0.086"/>
  <xacro:property name="caster_y_offset" value="0.0"/>
  <xacro:property name="caster_z_offset" value="-0.017"/>

   <!-- Inertial Mass Properties -->
  <xacro:property name="chassis_mass" value="0.5"/>
  <xacro:property name="wheel_mass" value="0.019"/>
  <xacro:property name="caster_mass" value="0.028"/>
  <xacro:property name="chassis_inertiaxx" value ="${chassis_mass * (chassis_y**2 + chassis_z**2) / 12}"/>
  <xacro:property name="chassis_inertiayy" value ="${chassis_mass * (chassis_x**2 + chassis_z**2) / 12}"/>
  <xacro:property name="chassis_inertiazz" value ="${chassis_mass * (chassis_x**2 + chassis_y**2) / 12}"/>
  <xacro:property name="wheel_inertiaxx" value ="${wheel_mass * (3 * wheel_radius**2 + wheel_length**2) / 12}"/>
  <xacro:property name="wheel_inertiayy" value ="${wheel_mass * (3 * wheel_radius**2 + wheel_length**2) / 12}"/>
  <xacro:property name="wheel_inertiazz" value ="${wheel_mass * (wheel_radius**2) / 2}"/>
  <xacro:property name="caster_inertiaxx" value ="${caster_mass * (2 * caster_radius**2) / 5}"/>
  <xacro:property name="caster_inertiayy" value ="${caster_mass * (2 * caster_radius**2) / 5}"/>
  <xacro:property name="caster_inertiazz" value ="${caster_mass * (2 * caster_radius**2) / 5}"/>

  <!-- Material Colors -->
  <material name="Chassis">
    <color rgba="0.5 0 0.5 0.5"/>
  </material>
  <material name="Wheel">
    <color rgba="0 0 0 0.5"/>
  </material>
  <material name="Caster">
    <color rgba="0.84 0.85 0.87 0.5"/>
  </material>

  <!-- ==================== ROBOT LINKS & JOINTS ==================== -->

  <!-- Base Footprint (Ground alignment) -->
  <link name="base_footprint"/>

  <!-- Chassis Body Link -->
  <link name="base_link">
    <visual>
      <origin xyz="${chassis_x_offset} ${chassis_y_offset} ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/CHASSIS.stl"/>
      </geometry>
      <material name="Chassis"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_x} ${chassis_y} ${chassis_z}"/>
      </geometry>
    </collision>
     <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_inertiaxx}" ixy="0.0" ixz="0.0" iyy="${chassis_inertiayy}" iyz="0.0" izz="${chassis_inertiazz}"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
  </joint>

<!-- Left Wheel Link -->
  <link name="left_wheel">
    <visual>
      <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/> 
      <geometry>
        <mesh filename="package://robot_description/meshes/LWHEEL.stl"/>
      </geometry>
      <material name="Wheel"/>
    </visual>
    <collision>
      <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="1.5708 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia ixx="${wheel_inertiaxx}" ixy="0.0" ixz="0.0" iyy="${wheel_inertiayy}" iyz="0.0" izz="${wheel_inertiazz}"/>
    </inertial>
  </link>

<joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${wheel_link_x_offset} ${wheel_link_y_offset} ${wheel_link_z_offset}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

<!-- Right Wheel Link -->
  <link name="right_wheel">
    <visual>
      <origin xyz="${wheel_x_offset} ${wheel_y_offset * -1} ${wheel_z_offset}" rpy="0 0 0"/> 
      <geometry>
        <mesh filename="package://robot_description/meshes/RWHEEL.stl"/>
      </geometry>
      <material name="Wheel"/>
    </visual>
    <collision>
      <origin xyz="${wheel_x_offset} ${wheel_y_offset * -1} ${wheel_z_offset}" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${wheel_x_offset} ${wheel_y_offset * -1} ${wheel_z_offset}" rpy="1.5708 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia ixx="${wheel_inertiaxx}" ixy="0.0" ixz="0.0" iyy="${wheel_inertiayy}" iyz="0.0" izz="${wheel_inertiazz}"/>
    </inertial> 
  </link>

<joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${wheel_link_x_offset} ${wheel_link_y_offset * -1} ${wheel_link_z_offset}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
   <!-- Caster Wheel Link -->
  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="Caster"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia ixx="${caster_inertiaxx}" ixy="0.0" ixz="0.0" iyy="${caster_inertiayy}" iyz="0.0" izz="${caster_inertiazz}"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${caster_x_offset} ${caster_y_offset} ${caster_z_offset}" rpy="0 0 0"/>
  </joint>

<!-- ==================== GAZEBO MATERIAL ASSIGNMENTS ==================== -->
  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="right_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="caster_wheel">
    <material>Gazebo/Grey</material>
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
  </gazebo>

  <!-- ==================== ROS2_CONTROL ==================== -->
  <!-- Actuation goes through ros2_control + diff_drive_controller for both -->
  <!-- Gazebo sim (via gz_ros2_control) and real hardware, so both share the -->
  <!-- same controller stack instead of Gazebo's native DiffDrive plugin. -->
  <xacro:include filename="$(find robot_description)/urdf/my_bot.ros2_control.xacro"/>
  <xacro:my_bot_ros2_control
      name="MyBot" prefix=""
      use_mock_hardware="$(arg use_mock_hardware)"
      use_gazebo="$(arg use_gazebo)"/>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find robot_description)/urdf/my_bot.gazebo.xacro"/>
    <xacro:my_bot_gazebo/>
  </xacro:if>

</robot>

