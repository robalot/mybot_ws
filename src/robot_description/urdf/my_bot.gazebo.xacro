<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="my_bot_gazebo" params="">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find robot_description)/config/my_bot_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
